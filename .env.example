# ─── MODO DE OPERACIÓN ────────────────────────────────────────────────────────
# MOCK_MODE=true  → usa el Mock LLM local (default, no requiere API key)
# MOCK_MODE=false → usa OpenAI/Anthropic real (requiere OPENAI_API_KEY)
MOCK_MODE=true

# ─── LLM (solo necesario si MOCK_MODE=false) ──────────────────────────────────
# Para usar Claude: cambia OPENAI_BASE_URL a https://api.anthropic.com/v1
OPENAI_BASE_URL=http://localhost:8001/v1
OPENAI_API_KEY=sk-mock-key-123

# ─── BACKEND ──────────────────────────────────────────────────────────────────
# URL que usa el frontend para conectarse al backend
# En Docker: http://backend:8000  |  En local: http://localhost:8000
BACKEND_URL=http://localhost:8000

# ─── SEGURIDAD (NO CAMBIAR EN DESARROLLO) ─────────────────────────────────────
# En producción: generar con `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=dev-secret-key-change-in-production

# ─── CÓMO USAR ────────────────────────────────────────────────────────────────
# 1. Copia este archivo: cp .env.example .env
# 2. Edita .env con tus valores (nunca lo commitees — ya está en .gitignore)
# 3. uv run --frozen uvicorn app.main:app --reload  (el backend cargará .env automáticamente)
